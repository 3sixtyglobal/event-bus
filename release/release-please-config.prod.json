{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"description": "Auto-Generated Release Please configuration for prod",
	"pull-request-title-pattern": "chore: prod release prepared",
	"group-pull-request-title-pattern": "chore: release ${branch}",
	"pull-request-header": "chore: prod release prepared",
	"pull-request-footer": "This PR was generated by the Release Production GHA",
	"release-type": "node",
	"initial-version": "0.0.1",
	"versioning": "default",
	"packages": {
		"packages/event-bus-models": {
			"package-name": "event-bus-models",
			"changelog-path": "docs/changelog.md"
		},
		"packages/event-bus-connector-local": {
			"package-name": "event-bus-connector-local",
			"changelog-path": "docs/changelog.md"
		},
		"packages/event-bus-service": {
			"package-name": "event-bus-service",
			"changelog-path": "docs/changelog.md"
		},
		"packages/event-bus-socket-client": {
			"package-name": "event-bus-socket-client",
			"changelog-path": "docs/changelog.md"
		}
	},
	"plugins": [
		"node-workspace",
		{
			"type": "linked-versions",
			"groupName": "repo",
			"components": [
				"event-bus-models",
				"event-bus-connector-local",
				"event-bus-service",
				"event-bus-socket-client"
			]
		}
	]
}
